# AI Forensic Analyzer — Environment Variables
# Copy this file to .env.local and fill in your API keys

# HuggingFace API Token (required for AI detection)
# Get yours at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=your_huggingface_token_here

# Google Gemini API Key (required for Vision-Language analysis)
# Get yours at: https://makersuite.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# VPT Artifact Sentinel Server URL
# Run the Python server: cd vpt_server && python server.py
VPT_SERVER_URL=http://localhost:8100
