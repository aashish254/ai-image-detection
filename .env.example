# OriginLayer — Environment Variables
# Copy this file to .env.local and fill in your API keys

# Google Gemini API Key (required for the vision-language read)
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Python server that hosts the local classifier and the VPT sentinel
# Run it with: cd vpt_server && python server.py
VPT_SERVER_URL=http://localhost:8100

# Optional: share the 24-hour result cache across processes
# REDIS_URL=redis://localhost:6379
